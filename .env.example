# 必填（服务启动前校验）
VLESS_HOST=你的服务器IP或域名
SUB_SECRET=订阅路径密钥
WS_PATH=/ws随机串

# 可选（默认值如下）
#SUB_PORT=8443
#VLESS_PORT=443
#WS_PORT=2053
#NET_IF=ens17
#XRAY_CONFIG=/usr/local/etc/xray/config.json
#CERT_FILE=/etc/xray-certs/fullchain.pem
#KEY_FILE=/etc/xray-certs/privkey.pem
#TOTAL_BYTES=214748364800

# Hysteria2 节点（HY2_AUTH 留空则不输出该节点）
#HY2_PORT=2096
#HY2_AUTH=与 /etc/hysteria/config.yaml 的 auth.password 一致
#HY2_OBFS=与 /etc/hysteria/config.yaml 的 obfs.salamander.password 一致；留空则不加混淆
