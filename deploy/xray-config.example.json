{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "UUID_PLACEHOLDER",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "HOST_PLACEHOLDER",
          "certificates": [
            {
              "certificateFile": "/etc/xray-certs/fullchain.pem",
              "keyFile": "/etc/xray-certs/privkey.pem"
            }
          ],
          "alpn": [
            "h2",
            "http/1.1"
          ],
          "minVersion": "1.3"
        }
      }
    },
    {
      "listen": "0.0.0.0",
      "port": 2053,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "UUID_PLACEHOLDER"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "websocket",
        "security": "tls",
        "tlsSettings": {
          "serverName": "HOST_PLACEHOLDER",
          "certificates": [
            {
              "certificateFile": "/etc/xray-certs/fullchain.pem",
              "keyFile": "/etc/xray-certs/privkey.pem"
            }
          ],
          "alpn": [
            "http/1.1"
          ]
        },
        "wsSettings": {
          "path": "/WS_PATH_PLACEHOLDER"
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": {
        "domainStrategy": "UseIP"
      }
    },
    {
      "tag": "blocked",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "dns": {
    "servers": [
      "localhost"
    ]
  },
  "routing": {
    "domainStrategy": "IPOnDemand",
    "rules": [
      {
        "type": "field",
        "ip": [
          "0.0.0.0/8",
          "10.0.0.0/8",
          "100.64.0.0/10",
          "127.0.0.0/8",
          "169.254.0.0/16",
          "172.16.0.0/12",
          "192.0.0.0/24",
          "192.0.2.0/24",
          "192.88.99.0/24",
          "192.168.0.0/16",
          "198.18.0.0/15",
          "198.51.100.0/24",
          "203.0.113.0/24",
          "224.0.0.0/4",
          "240.0.0.0/4",
          "::/96",
          "64:ff9b::/96",
          "64:ff9b:1::/48",
          "100::/64",
          "2001::/32",
          "2001:10::/28",
          "2001:20::/28",
          "2001:db8::/32",
          "2002::/16",
          "fc00::/7",
          "fe80::/10",
          "fec0::/10",
          "ff00::/8",
          "HOST_IP_CIDR_PLACEHOLDER"
        ],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "domain": [
          "domain:localhost",
          "domain:local",
          "domain:internal",
          "full:HOST_PLACEHOLDER"
        ],
        "outboundTag": "blocked"
      }
    ]
  }
}
