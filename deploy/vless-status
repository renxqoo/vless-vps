#!/usr/bin/env python3
"""Read-only health check. Never print server addresses or subscription credentials."""
import argparse
import datetime
import http.client
import os
import pathlib
import ssl
import socket
import subprocess
import sys
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--subscription-only", action="store_true")
args = parser.parse_args()
failed = False


def report(name, ok, detail):
    global failed
    print(f"{'OK' if ok else 'FAIL'} {name}: {detail}")
    failed |= not ok


def main():
    values = {}
    for line in pathlib.Path(os.environ.get("VLESS_ENV_FILE", "/usr/local/bin/.env")).read_text().splitlines():
        key, sep, value = line.partition("=")
        if sep and key and not key.startswith("#"):
            values.setdefault(key, value)

    if not args.subscription_only:
        for unit in ["xray", "vless-sub", "vnstat"] + (["hysteria"] if values.get("HY2_AUTH") else []):
            result = subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True)
            report(unit, result.returncode == 0, result.stdout.strip() or "unknown")

        cert = ssl._ssl._test_decode_cert(values.get("CERT_FILE", "/etc/xray-certs/fullchain.pem"))
        remaining = ssl.cert_time_to_seconds(cert["notAfter"]) - time.time()
        expires = datetime.datetime.fromtimestamp(ssl.cert_time_to_seconds(cert["notAfter"]), datetime.timezone.utc)
        report("certificate", remaining > 0, f"{remaining / 3600:.1f} hours left; expires {expires.isoformat()}")
        if 0 < remaining < 24 * 3600:
            print("WARN certificate: less than 24 hours left; check acme.sh renewal")

        if values.get("HY2_AUTH"):
            for name in ["rmem_max", "wmem_max"]:
                size = int(pathlib.Path(f"/proc/sys/net/core/{name}").read_text())
                report(f"UDP {name}", size >= 16777216, f"{size} bytes")

    host = values["VLESS_HOST"]
    started = time.monotonic()
    # Use the configured identity against loopback; do not bypass certificate validation.
    context = ssl.create_default_context()
    connection = http.client.HTTPSConnection(host, int(values.get("SUB_PORT", "8443")), timeout=10, context=context)
    connection._create_connection = lambda address, timeout, source_address=None: socket.create_connection(("127.0.0.1", address[1]), timeout, source_address)
    try:
        connection.request("GET", f"/{values['SUB_SECRET']}/sub", headers={"User-Agent": "mihomo-healthcheck"})
        response = connection.getresponse()
        body = response.read().decode()
        nodes = ["wr-vps-vision", "wr-vps-ws"] + (["wr-vps-hy2"] if values.get("HY2_AUTH") else [])
        ok = response.status == 200 and "yaml" in response.getheader("Content-Type", "") and all(f'name: "{node}"' in body for node in nodes)
        ok &= bool(response.getheader("subscription-userinfo"))
        report("subscription", ok, f"HTTP {response.status}, {len(nodes)} expected nodes, {(time.monotonic() - started) * 1000:.1f} ms, TLS verified")
    finally:
        connection.close()


try:
    main()
except Exception as error:
    report("healthcheck", False, type(error).__name__)
sys.exit(1 if failed else 0)
