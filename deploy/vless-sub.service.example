[Unit]
Description=VLESS subscription endpoint
After=network.target xray.service

[Service]
User=xray
Group=xray
ExecStart=/usr/local/bin/bun run /usr/local/bin/vless-sub-server.js
WorkingDirectory=/usr/local/bin
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadOnlyPaths=/usr/local/etc/xray /etc/xray-certs

[Install]
WantedBy=multi-user.target
